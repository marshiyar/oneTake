// The keyframe engine's C interface. The header and the dynamic library are not in this repository: they come from
// the release pinned in binaries.lock (`python3 scripts/fetch-binaries.py` puts them in .binaries/keyframes/).
module CKeyframeEngine [system] {
    header "../../.binaries/keyframes/include/cvkf.h"
    link "cvkf"
    export *
}
